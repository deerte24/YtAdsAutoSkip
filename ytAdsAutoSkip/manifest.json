{
    "name": "YouTube Ads Skipper",
    "description": "Auto Skip Ads for YouTube when Skip-Ads Button pop-ups.",
    "version": "1.0",
    "manifest_version": 3,
    "host_permissions": [
        "https://www.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}